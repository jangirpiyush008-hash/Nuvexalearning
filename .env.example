# =============================================================================
# Nuvexa Studio — environment template
# Copy to .env.local (app/) and supabase/.env, fill in real values, never commit.
# =============================================================================

# --- Client (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
EXPO_PUBLIC_POSTHOG_KEY=phc_xxx
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Server (Supabase Edge Functions) ---
# Supabase auto-injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY into functions.
# You only need to set the third-party secrets via `supabase secrets set`.

# Apple shared secret (App Store Connect → Apps → App-Specific Shared Secret)
APPLE_SHARED_SECRET=

# Anthropic Claude API
ANTHROPIC_API_KEY=

# Cloudflare Stream
CF_ACCOUNT_ID=
CF_STREAM_CUSTOMER=
CF_STREAM_API_TOKEN=

# Optional: PostHog server key for server-side events
POSTHOG_PROJECT_KEY=
