# Public — bundled into the client. Anon key only, NEVER service role.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
EXPO_PUBLIC_POSTHOG_KEY=phc_xxx
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Google Sign-In — from Google Cloud Console → OAuth 2.0 Client IDs.
# - iOS client: bundle id studio.nuvexa.app
# - Web client: copy the SAME web client ID into Supabase → Auth → Providers → Google.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxx-yyyy.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxx-zzzz.apps.googleusercontent.com
